# backend/.env 로 복사한 뒤 실제 값을 채운다. (.env는 git에 커밋되지 않음)

# Supabase Postgres
# Koyeb 등 IPv4 전용 PaaS에서는 Direct Connection(db.<project-ref>.supabase.co, IPv6)이 아니라 Session Pooler(Supavisor)를 사용한다.
# 포트 구분: 5432 = Session 모드(JPA/Flyway와 궁합 좋음, 권장) / 6543 = Transaction 모드 (prepared statement·Flyway advisory lock과 충돌 가능 — 꼭 써야 한다면 URL 끝에 ?prepareThreshold=0 을 붙여 완화)
# ⚠️ pgJDBC는 URL에 user:password@host 형태(userinfo)를 지원하지 않는다 — 반드시 username/password를 아래처럼 별도 값으로 분리해서 넣을 것 (URL에 자격증명 포함 금지).
SUPABASE_DB_URL=jdbc:postgresql://aws-<shard>-<region>.pooler.supabase.com:5432/postgres
# Session/Transaction Pooler 공통 규칙: 항상 "postgres.<project-ref>" 형식 (project-ref만 넣지 않는다)
SUPABASE_DB_USERNAME=postgres.<project-ref>
SUPABASE_DB_PASSWORD=

# Supabase Storage (S3 호환)
# endpoint는 "<project-ref>.storage.supabase.co/storage/v1/s3" 형식 (일반 API 도메인 아님, storage 서브도메인 사용 시 대용량 업로드 성능 개선)
SUPABASE_STORAGE_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_BUCKET=
# ⚠️ anon / service_role / publishable / secret API 키와는 완전히 다른 별도 자격증명이다.
#    대시보드 > Storage > S3 Connection 페이지에서 "New access key"로 새로 발급받을 것.
#    전체 버킷에 대한 접근 권한 + RLS 우회 권한을 가지므로 반드시 서버(backend)에서만 사용.
SUPABASE_STORAGE_ACCESS_KEY=
SUPABASE_STORAGE_SECRET_KEY=

# Redis (로컬은 docker-compose 기본값 사용)
REDIS_HOST=localhost
REDIS_PORT=6379

# 자체 로그인 JWT
JWT_SECRET=your_jwt_secret_key

# OAuth2 소셜 로그인
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=

# Anthropic Claude API
CLAUDE_API_KEY=

# PortOne (포트원) 결제
# API Secret과 Webhook Secret은 서로 다른 값이다 — 관리자콘솔 > 결제 연동 > 연동 관리에서
# API Secret은 "REST API 연동 정보", Webhook Secret은 "결제알림(Webhook) 관리"에서 각각 발급받을 것
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET= # TODO: 추 후, 관련 기능 완성되면 추가할 것
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=

# EXPO_PUBLIC_ 접두사가 붙은 값은 빌드 시 번들에 그대로 인라인되므로 비밀값을 넣지 않는다.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Google 로그인(expo-auth-session) — Google Cloud Console에서 발급한 OAuth 2.0 클라이언트 ID.
# 백엔드(backend/.env의 GOOGLE_OAUTH_CLIENT_ID)와 같은 값을 쓴다 — 백엔드가 idToken의 audience를 이 값으로 검증한다.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Pro 구독 결제(@portone/browser-sdk) — PortOne 콘솔의 상점 ID/채널 키. 둘 다 브라우저에 노출되는 것을
# 전제로 설계된 공개 식별자라 EXPO_PUBLIC_로 둬도 안전하다(API 시크릿/웹훅 시크릿과는 다름 — 그건
# backend/.env에만 있다). 웹 빌드에서만 쓰인다(§4-5 Google 로그인과 동일한 이유로 네이티브는 별도 SDK 필요).
EXPO_PUBLIC_PORTONE_STORE_ID=
EXPO_PUBLIC_PORTONE_CHANNEL_KEY=
